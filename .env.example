# garmin-mcp: copy to .env and fill in. docker compose reads this file twice: for the
# ${...} values in compose.yaml (ports, image tag, memory limits, the optional profiles)
# and, through env_file, as the server's environment. Every setting the server reads
# is listed here with its default; a commented-out line keeps the default
# (docs/configuration.md describes each one).

# ----------------------------------------------------------------- required

# Bearer token MCP clients must send on /mcp (Authorization: Bearer ...). Generate one:
#   openssl rand -hex 32
MCP_BEARER_TOKEN=

# ----------------------------------------------------------------- stack (compose only)

# Image tag to run (a release X.Y.Z, X.Y or X; see the releases page).
#GARMIN_MCP_VERSION=1
# Host port for the MCP endpoint (http://localhost:8000/mcp).
#GARMIN_MCP_PORT=8000
# Container memory limit. Peak RSS is about 100 MB + DUCKDB_MEMORY_LIMIT + 300 MB of
# transient parsing memory; raise both together for very large mirrors.
#GARMIN_MCP_MEMORY=1536M

# ----------------------------------------------------------------- server

# DuckDB's buffer pool limit and worker threads (the image's defaults; docs/operations.md).
#DUCKDB_MEMORY_LIMIT=512MB
#DUCKDB_THREADS=2
# Bearer token for GET /snapshot.duckdb (unset: the snapshot is not served over HTTP).
#SNAPSHOT_TOKEN=
# Hostnames clients use to reach the server, comma-separated, when it sits behind a reverse
# proxy (e.g. garmin.example.com). Enables Host-header (DNS-rebinding) protection.
#MCP_ALLOWED_HOSTS=
# Serve each request without a session id, for clients or proxies that cannot keep one.
#MCP_STATELESS_HTTP=false
# debug, info, warning, error
#LOG_LEVEL=info
# Where the mirror and the snapshot live. The image keeps them on the /data volume; set
# these only outside Docker.
#GARMIN_DB_PATH=
#GARMIN_SNAPSHOT_DIR=
# Where garmin-mcp-auth stores the tokens and the server reads them (/data/tokens in the image).
#GARMINTOKENS=

# ----------------------------------------------------------------- Garmin account

# true for Garmin Connect China (garmin.cn). Must match when running garmin-mcp-auth.
#GARMIN_IS_CN=false
# Earliest date the mirror backfills (YYYY-MM-DD). Default: the first activity or the
# account's creation date.
#GARMIN_HISTORY_START=
# Optional first-login fallback for accounts without MFA; the normal way is the one-time
#   docker compose run --rm garmin-mcp garmin-mcp-auth
# which prompts for these and the MFA code. Never needed once tokens exist.
#GARMIN_EMAIL=
#GARMIN_PASSWORD=
# off: serve the mirror and fetch on demand only, no background sync or snapshots.
#GARMIN_SYNC=on

# ----------------------------------------------------------------- strava sync (optional)

# Strava activity names onto Garmin, and removal of courses Strava's sync left behind after
# a route was unstarred. Reads strava-mcp's live export (or, with STRAVA_SNAPSHOT instead,
# its hourly snapshot); see docs/strava-sync.md. Off unless set: titles, courses, or all.
#STRAVA_SYNC=titles,courses
# strava-mcp's export (GET /export/sync) and the token it expects (its SNAPSHOT_TOKEN).
#STRAVA_EXPORT_URL=http://strava-mcp:8000/export/sync
#STRAVA_EXPORT_TOKEN=
# Instead of the export: a strava-mcp snapshot file (mounted read-only) or its URL.
#STRAVA_SNAPSHOT=
# on: delete orphaned Strava-made courses; dry-run only reports them.
#STRAVA_SYNC_COURSES=dry-run
# Rename only activities that started on or after this date (default: the day the sync first ran).
#STRAVA_SYNC_TITLES_SINCE=
# Caps and guards per run, and how often the sync runs.
#STRAVA_SYNC_MAX_RENAMES=20
#STRAVA_SYNC_MAX_DELETES=10
#STRAVA_SYNC_MAX_AGE_HOURS=48
#STRAVA_SYNC_INTERVAL_MINUTES=2
# Regular expression for Strava's automatic activity names, which are never copied to Garmin.
# The default matches the English ones; Strava localizes them (an Italian account sees
# "Passeggiata mattutina"), so set the pattern for your language.
#STRAVA_DEFAULT_NAME_PATTERN=^(Morning|Lunch|Afternoon|Evening|Night) \S.*$
# Garmin consumer ids whose courses count as Strava-made (default: Strava's own).
#STRAVA_COURSE_CONSUMERS=

# ----------------------------------------------------------------- tools

# Narrow the tool set an MCP client sees: all, minimal, health, activities, workouts,
# training, nutrition (several comma-separated). The mirror tools are always included.
#GARMIN_TOOL_PROFILE=
# Allowlist / denylist of tool names, comma-separated (see docs/reference/tools.md).
#GARMIN_ENABLED_TOOLS=
#GARMIN_DISABLED_TOOLS=
# Tool results longer than this are truncated with a note.
#GARMIN_MCP_CHARACTER_LIMIT=60000
# Where download_activity_file and download_course_gpx save files, and the config file
# set_fit_download_dir writes (inside the container: /data/downloads, /data/fit_config.json).
#GARMIN_FIT_DOWNLOAD_DIR=
#GARMIN_FIT_CONFIG=

# ----------------------------------------------------------------- profile oauth

# Your OpenID Connect provider (Authelia, Authentik, Keycloak, Pocket ID, ...):
# the issuer URL exactly as it appears in the provider's discovery document, its JWKS URL,
# and the client id you registered for this server. See docs/authentication.md.
#OIDC_ISSUER=https://auth.example.com
#OIDC_JWKS_URL=https://auth.example.com/jwks.json
#OIDC_CLIENT_ID=garmin-mcp
# The public HTTPS URL at which your reverse proxy exposes the oauth service (port 3000).
#PUBLIC_URL=https://garmin.example.com
#OAUTH_PORT=3000
# Largest JSON-RPC request body accepted, in bytes.
#MCP_BUFFER=4194304

# ----------------------------------------------------------------- profile grafana

#GRAFANA_ADMIN_USER=admin
# Grafana asks to change it at the first sign-in while it is still "admin".
#GRAFANA_ADMIN_PASSWORD=admin
#GRAFANA_PORT=3001
#GRAFANA_MEMORY=1024M
# MotherDuck's DuckDB datasource plugin release (github.com/motherduckdb/grafana-duckdb-datasource).
#GRAFANA_DUCKDB_PLUGIN_VERSION=0.4.6

# ----------------------------------------------------------------- profile notebooks

#NOTEBOOKS_PORT=2718
#NOTEBOOKS_MEMORY=1024M

# ----------------------------------------------------------------- profile backup

# Where archives land on the host (tokens, FIT files and the snapshot; never the live file).
#BACKUP_DIR=./backups
# Cron expression (container time, UTC) and how many days of archives to keep.
#BACKUP_CRON=0 4 * * *
#BACKUP_RETENTION_DAYS=14
