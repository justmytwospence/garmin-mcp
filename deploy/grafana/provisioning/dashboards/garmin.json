    {
      "id": 10,
      "type": "timeseries",
      "title": "Training load",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "garmin"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "garmin"
          },
          "refId": "A",
          "rawSql": "SELECT calendar_date::TIMESTAMP AS time,\n  TRY_CAST(acute_training_load->>'dailyTrainingLoadAcute' AS DOUBLE) AS \"acute load\",\n  TRY_CAST(acute_training_load->>'dailyTrainingLoadChronic' AS DOUBLE) AS \"chronic load\",\n  TRY_CAST(acute_training_load->>'minTrainingLoadChronic' AS DOUBLE) AS \"optimal low\",\n  TRY_CAST(acute_training_load->>'maxTrainingLoadChronic' AS DOUBLE) AS \"optimal high\"\nFROM training_status WHERE $__timeFilter(calendar_date::TIMESTAMP) AND acute_training_load IS NOT NULL ORDER BY 1",
          "format": 0,
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "optimal.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "options": {
