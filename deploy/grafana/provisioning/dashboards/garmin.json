          },
          "refId": "A",
          "rawSql": "SELECT date_trunc('week', start_time_local)::TIMESTAMP AS time, activity_type, sum(duration) / 3600.0 AS hours\nFROM activity WHERE deleted_at IS NULL AND $__timeFilter(start_time_local) GROUP BY 1, 2 ORDER BY 1, 2",
