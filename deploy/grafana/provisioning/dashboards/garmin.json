    {
      "id": 17,
      "type": "stat",
      "title": "Errors (24 h)",
      "datasource": {
        "type": "motherduck-duckdb-datasource",
        "uid": "garmin"
      },
      "gridPos": {
        "x": 8,
        "y": 51,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "motherduck-duckdb-datasource",
            "uid": "garmin"
          },
          "refId": "A",
          "rawSql": "SELECT count(*) AS errors FROM sync_log WHERE outcome IN ('error', 'auth_error') AND logged_at > now() - INTERVAL 1 DAY",
          "format": 1,
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
